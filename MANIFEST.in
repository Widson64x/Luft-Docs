include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include pyproject.toml
include MANIFEST.in
include .gitattributes
include requirements.txt
include _version.py

graft .githooks
graft scripts
graft Luft-Docs
graft LuftDocs_API

prune .github
prune .LUFTDOCS_PACKAGES
prune .venv
prune .vscode
prune __pycache__

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.log